# Application
APP_ENV=dev
APP_TIMEZONE=Europe/Tallinn

# Project identity
PROJECT_SLUG=ai-assistant-template
COMPOSE_PROJECT_NAME=ai-assistant-template

# Public URLs (used for login links and webhooks)
BOT_PUBLIC_URL=https://bot.example.com
ADMIN_PUBLIC_URL=https://admin.example.com

# Host ports (for Docker Compose port binding)
BOT_HOST_PORT=18001
ADMIN_HOST_PORT=18002

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_MODE=polling

# Admin access
ROOT_ADMIN_TG_ID=
ADMIN_LOGIN_TOKEN_TTL_MINUTES=15

# Admin notifications (optional — send_to_admin falls back to DB if empty)
ADMIN_TELEGRAM_CHAT_ID=

# Artifact Generator
ARTIFACT_WORKER_POLL_INTERVAL_SEC=5
ARTIFACT_GENERATOR_TEMPERATURE=0.3
ARTIFACT_GENERATOR_MAX_RETRIES=3

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change_me

# LLM
TEXT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Anthropic (alternative LLM provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ai-assistant-template
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TAGS=telegram,production
LANGSMITH_SAMPLE_RATE=1.0

# Admin session
SESSION_SECRET=
SESSION_COOKIE_NAME=assistant_admin_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Censor / response reviewer
CENSOR_ENABLED=false

# Voice recognition
VOICE_ENABLED=false
VOICE_TEMP_DIR=/tmp/assistant-audio
SPEECH_TEMP_DIR=/tmp/assistant-audio
VOICE_MAX_AUDIO_SIZE_MB=25
VOICE_MAX_DURATION_SEC=120

# OpenAI STT
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_LANGUAGE=
OPENAI_STT_TIMEOUT_MS=60000

# OpenAI TTS
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_FALLBACK_VOICE=cedar
OPENAI_TTS_RESPONSE_FORMAT=opus
OPENAI_TTS_TIMEOUT_MS=60000
OPENAI_TTS_MAX_CHARS=4096
OPENAI_TTS_SPEED=1.0
OPENAI_TTS_INSTRUCTIONS=

# Aisha STT (fallback, primarily Uzbek)
AISHA_API_KEY=
AISHA_BASE_URL=
AISHA_STT_TIMEOUT_MS=60000
AISHA_STT_LANGUAGE=uz

# Aisha TTS
AISHA_TTS_TIMEOUT_MS=60000
AISHA_TTS_MAX_CHARS=1000
AISHA_TTS_LANGUAGE=uz
AISHA_TTS_MODEL=Gulnoza
AISHA_TTS_MOOD=Neutral
AISHA_TTS_SPEED=1.0

# Yandex SpeechKit TTS
YANDEX_SPEECHKIT_API_KEY=
YANDEX_TTS_BASE_URL=https://tts.api.cloud.yandex.net
YANDEX_TTS_MODEL=yandex-speechkit-tts-v1
YANDEX_TTS_LANGUAGE=ru-RU
YANDEX_TTS_VOICE=alena
YANDEX_TTS_EMOTION=good
YANDEX_TTS_SPEED=1.15
YANDEX_TTS_FORMAT=oggopus
YANDEX_TTS_TIMEOUT_MS=60000
YANDEX_TTS_MAX_CHARS=5000

# Azure Speech TTS (optional alternative adapter)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_ENDPOINT=
AZURE_TTS_LANGUAGE=ru-RU
AZURE_TTS_VOICE=ru-RU-SvetlanaNeural
AZURE_TTS_OUTPUT_FORMAT=ogg-24khz-16bit-mono-opus
AZURE_TTS_RATE=20%
AZURE_TTS_PITCH=
AZURE_TTS_RANGE=
AZURE_TTS_TIMEOUT_MS=60000
AZURE_TTS_MAX_CHARS=5000
