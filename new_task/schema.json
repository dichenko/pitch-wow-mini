{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "language",
    "deck",
    "startup",
    "founder",
    "business",
    "assessment",
    "recommendation",
    "slide_copy",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "template_id": {
      "type": "string",
      "const": "vc_founder_dossier_v1"
    },
    "language": {
      "type": "string",
      "enum": ["ru", "en"]
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "assistant_name", "prepared_for", "prepared_at"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "assistant_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "prepared_for": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fund_name", "recipient_role"],
          "properties": {
            "fund_name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "recipient_role": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "prepared_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "industry", "stage", "one_line", "location"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "industry": { "type": "string", "minLength": 1, "maxLength": 80 },
        "stage": { "type": "string", "minLength": 1, "maxLength": 120 },
        "one_line": { "type": "string", "minLength": 1, "maxLength": 260 },
        "location": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "founder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "role", "background_short", "founder_strength"],
      "properties": {
        "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "background_short": { "type": "string", "minLength": 1, "maxLength": 320 },
        "founder_strength": { "type": "string", "minLength": 1, "maxLength": 360 }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["essence", "customer", "payer", "business_model", "traction"],
      "properties": {
        "essence": { "type": "string", "minLength": 1, "maxLength": 320 },
        "customer": { "type": "string", "minLength": 1, "maxLength": 220 },
        "payer": { "type": "string", "minLength": 1, "maxLength": 260 },
        "business_model": { "type": "string", "minLength": 1, "maxLength": 260 },
        "traction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "schools_count", "users_count", "monthly_revenue_usd", "team_size"],
          "properties": {
            "summary": { "type": "string", "minLength": 1, "maxLength": 260 },
            "schools_count": { "type": "integer", "minimum": 0 },
            "users_count": { "type": "integer", "minimum": 0 },
            "monthly_revenue_usd": { "type": "number", "minimum": 0 },
            "team_size": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "readiness",
        "risks",
        "red_flags",
        "positive_signals",
        "unknowns"
      ],
      "properties": {
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "label", "icon", "tone"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "ready_for_committee",
                "needs_more_data",
                "watchlist",
                "reject",
                "unknown"
              ]
            },
            "label": { "type": "string", "minLength": 1, "maxLength": 120 },
            "icon": { "type": "string", "minLength": 1, "maxLength": 8 },
            "tone": {
              "type": "string",
              "enum": ["positive", "neutral", "warning", "negative"]
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "title", "comment"],
          "properties": {
            "level": {
              "type": "string",
              "enum": ["low", "medium", "high", "unknown"]
            },
            "title": { "type": "string", "minLength": 1, "maxLength": 80 },
            "comment": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 220 }
        },
        "red_flags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "text"],
            "properties": {
              "level": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "text": { "type": "string", "minLength": 1, "maxLength": 260 }
            }
          }
        },
        "positive_signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 220 }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 220 }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "comment", "next_steps"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
        "comment": { "type": "string", "minLength": 1, "maxLength": 260 },
        "next_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 220 }
        }
      }
    },
    "slide_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "title", "subtitle", "sections"],
      "properties": {
        "kicker": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "essence",
            "payer",
            "traction",
            "founder_strength",
            "risks",
            "readiness",
            "fund_note"
          ],
          "properties": {
            "essence": { "$ref": "#/$defs/slideSection" },
            "payer": { "$ref": "#/$defs/slideSection" },
            "traction": { "$ref": "#/$defs/slideSection" },
            "founder_strength": { "$ref": "#/$defs/slideSection" },
            "risks": { "$ref": "#/$defs/slideSection" },
            "readiness": { "$ref": "#/$defs/slideSection" },
            "fund_note": { "$ref": "#/$defs/slideSection" }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "needs_human_review", "reason", "source_type", "evidence"],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "needs_human_review": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 320 },
        "source_type": {
          "type": "string",
          "enum": [
            "founder_interview",
            "documents",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "source", "quote"],
            "properties": {
              "field": { "type": "string", "minLength": 1, "maxLength": 160 },
              "source": {
                "type": "string",
                "enum": [
                  "founder_statement",
                  "document",
                  "assistant_inference",
                  "external_source",
                  "unknown"
                ]
              },
              "quote": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slideSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "body": { "type": "string", "minLength": 1, "maxLength": 360 }
      }
    }
  }
}
